{
  "name": "sf6-combo-builder",
  "version": "1.0.0",
  "description": "SF6 combo icon builder desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nuppori.sf6combobuilder",
    "productName": "SF6ComboBuilder",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "SF6ComboBuilder-${version}.${ext}"
    }
  }
}
